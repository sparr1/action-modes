{
    "seed": 55,
    "env": "Ant-v4",
    "alg": "AMBIMujoco/AMBI",
    "device": "cuda",
    "alg_params": {
        "outer_alg": "baselines/SAC",
        "outer_alg_params": {
            "verbose": 1,
