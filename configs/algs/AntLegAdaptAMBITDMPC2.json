{
    "seed": 55,
    "env": "LegAdaptAnt-v0",
    "alg": "AMBITDMPC2/AMBITDMPC2",
    "device": "cuda",
    "alg_params": {
        "model_size": 5,
        "episodic": false,
        "discount": 0.99,
        "buffer_size": 1000000,
        "batch_size": 256,
        "utd": 1,
        "train_unroll_horizon": 3,
        "outer_planning_horizon": 3,
        "rho": 0.7,
        "temporal_loss_normalization": "reference_weighted_mean",
        "temporal_loss_reference_horizon": 3,
        "compile": true,
        "compile_strict": false,
        "q_representation": "distributional",
        "q_num_bins": 101,
        "q_vmin": -10,
        "q_vmax": 10,
        "q_pair_size": 2,
        "dropout": 0.01,
        "actor_lr": 0.0003,
        "critic_lr": 0.0003,
        "adam_eps": 1e-8,
        "log_std_min": -20,
        "log_std_max": 2,
        "critic_coef": 1.0,
        "ent_coef": "auto",
        "target_entropy": "auto",
        "tau": 0.005,
        "target_update_interval": 1,
        "inner_operator": "sac",
        "inner_rounds": 4,
        "inner_rollouts_per_round": 64,
        "inner_rollout_horizon": 3,
        "inner_updates_per_round": "auto",
        "inner_batch_size": 128,
        "inner_replay_capacity": 768,
        "inner_replay_sampling": "with_replacement",
        "inner_diagnostics_every": 1000,
        "inner_actor_adaptation": "clone",
        "inner_critic_adaptation": "clone",
        "inner_temperature_mode": "auto",
        "inner_temperature_initialization": "inherit_outer",
        "inner_target_entropy": "inherit_outer",
        "inner_bootstrap_source": "inner_target",
        "inner_actor_lr": 0.00005,
        "inner_critic_lr": 0.00005,
        "inner_temperature_lr": 0.00005,
        "inner_adam_eps": 1e-8,
        "inner_critic_target_tau": 0.005,
        "inner_critic_target_update_interval": 1,
        "inner_behavior_action": "policy_sample",
        "inner_execution_action": "policy_sample",
        "inner_actor_scope": "action",
        "inner_critic_scope": "action",
        "inner_temperature_scope": "action",
        "inner_replay_scope": "action",
        "wandb": true,
        "wandb_project": "ambi",
        "wandb_step_every": 1000,
        "wandb_entity": "heewon_seo",
        "wandb_tags": ["leg-adaptation", "ambi-tdmpc2-clone"]
    },
    "total_steps": 1000000,
    "episodes": null
}
