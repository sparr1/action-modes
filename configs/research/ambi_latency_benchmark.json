    "inner_update_slots": "J * G",
    "inner_critic_optimizer_steps": "J * G",
    "inner_actor_optimizer_steps": "J * G",
    "inner_temperature_optimizer_steps": "0 because the base uses inner_temperature_mode=inherit_outer",
    "inner_critic_target_updates": "J * G because the base target-update interval is 1",
    "inner_replay_draws": "J * G * B",
    "inner_policy_evaluations": "J * N * H + 2 * J * G * B + 1",
    "inner_q_evaluations": "3 * J * G * B"
