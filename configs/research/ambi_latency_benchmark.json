{
  "schema_version": 1,
  "benchmark": "ambi-inner-latency",
  "metadata": {
    "description": "Action-selection latency matrix around the current Humanoid Walk G4 AMBI configuration. The benchmark loads one fixed outer checkpoint and never trains or steps the environment.",
