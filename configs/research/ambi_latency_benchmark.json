    "deduplication": "The center belongs to all four families and appears exactly once, leaving 15 unique J/N/G cells.",
    "families": {
      "G": "Hold J=2 and N=32; vary G over 0, 2, 4, 8, 16.",
      "N": "Hold J=2 and G=4; vary N over 8, 16, 32, 64, 128.",
      "natural_J": "Hold N=32 and G=4; vary J over 1, 2, 4, 8.",
      "matched_work_J": "Vary J while holding J*N*H=192 imagined transitions and J*G=8 update slots."
    }
  },
  "base": {
    "algorithm_config": "../dmcontrol/algs/ambi_humanoid_walk_updates_g4.json",
