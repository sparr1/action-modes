{
  "schema_version": 1,
  "description": "One-axis-at-a-time AMBI inner-loop comparisons. Materialize these presets for training, or evaluate checkpoint-compatible presets with evaluate_ambi_checkpoint.py.",
  "base_alg_config": "../../algs/AntAMBITDMPC2.json",
  "shared_alg_params": {
    "inner_diagnostic_rollouts": 8
  },
  "environment": {
    "id": "Ant-v4",
    "params": {
      "render_mode": null,
      "exclude_current_positions_from_observation": true,
      "max_episode_steps": 1000,
      "terminate_when_unhealthy": false
    }
  },
  "evaluation": {
    "controller_seed": 55,
    "seeds": [101, 102, 103, 104, 105],
    "max_steps": 1000,
    "default_presets": [
      "inner_operator/none",
      "inner_operator/sac",
      "inner_operator/td3",
      "inner_operator/mppi"
    ]
  },
  "comparisons": {
    "inner_operator": {
      "description": "Compare no improvement, SAC, TD3, and MPPI from the same outer checkpoint. Active operators receive 768 imagined model steps per real action.",
      "reference": "sac",
      "variants": {
        "none": {
          "description": "Outer-policy control with no imagined work.",
          "alg_params": {
            "inner_operator": "none",
            "inner_rounds": null,
            "inner_rollouts_per_round": null,
            "inner_rollout_horizon": null,
            "inner_updates_per_round": null
          }
        },
        "sac": {
          "description": "Full-copy SAC improvement with four collect/train rounds and UTD one.",
          "alg_params": {
            "inner_operator": "sac"
          }
        },
        "td3": {
          "description": "Deterministic TD3 improvement with Gaussian imagined behavior exploration.",
          "alg_params": {
            "inner_operator": "td3",
            "inner_rounds": 4,
            "inner_rollouts_per_round": 64,
            "inner_rollout_horizon": 3,
            "inner_updates_per_round": "auto",
            "inner_temperature_mode": "inherit_outer",
            "inner_behavior_action": "mean_plus_gaussian",
            "inner_behavior_noise_std": 0.1,
            "inner_execution_action": "mean"
          }
        },
        "mppi": {
          "description": "MPPI with 128 candidates, 8 elites, two iterations, and no policy-prior trajectories.",
          "alg_params": {
            "inner_operator": "mppi",
            "inner_rounds": null,
            "inner_rollouts_per_round": null,
            "inner_updates_per_round": null,
            "inner_model_step_budget": 768,
            "inner_mppi_iterations": 2,
            "inner_rollout_horizon": 3,
            "inner_mppi_num_elites": 8,
            "inner_mppi_num_pi_trajs": 0,
            "inner_mppi_temperature": 0.5
          }
        }
      }
    },
    "q_representation": {
      "description": "Change only critic representation while retaining the same soft-SAC Bellman objective. Each variant requires a checkpoint trained with the matching architecture.",
      "reference": "distributional_five",
      "variants": {
        "scalar_twin": {
          "description": "Two scalar soft-Q heads.",
          "alg_params": {
            "q_representation": "scalar",
            "num_q": 2,
            "q_pair_size": 2
          }
        },
        "distributional_five": {
          "description": "Five categorical/two-hot soft-Q heads.",
          "alg_params": {
            "q_representation": "distributional",
            "num_q": 5,
            "q_num_bins": 101,
            "q_vmin": -10,
            "q_vmax": 10,
            "q_pair_size": 2
          }
        }
      }
    },
    "adapted_components": {
      "description": "Toggle SAC adaptation components without changing collection compute.",
      "reference": "actor_critic",
      "variants": {
        "actor_critic": {
          "description": "Adapt full actor and critic copies; inherit the frozen outer alpha.",
          "alg_params": {
            "inner_actor_adaptation": "clone",
            "inner_critic_adaptation": "clone",
            "inner_temperature_mode": "inherit_outer"
          }
        },
        "actor_only": {
          "description": "Adapt the actor against a frozen critic snapshot.",
          "alg_params": {
            "inner_actor_adaptation": "clone",
            "inner_critic_adaptation": "frozen",
            "inner_temperature_mode": "inherit_outer"
          }
        },
        "critic_only": {
          "description": "Adapt the critic while returning the frozen outer-policy action.",
          "alg_params": {
            "inner_actor_adaptation": "frozen",
            "inner_critic_adaptation": "clone",
            "inner_temperature_mode": "inherit_outer"
          }
        },
        "temperature_only": {
          "description": "Adapt only a local SAC temperature; actor and critic remain frozen.",
          "alg_params": {
            "inner_actor_adaptation": "frozen",
            "inner_critic_adaptation": "frozen",
            "inner_temperature_mode": "auto",
            "inner_temperature_initialization": "inherit_outer",
            "inner_target_entropy": "inherit_outer"
          }
        },
        "all_frozen": {
          "description": "Collect imagined data but perform no parameter updates.",
          "alg_params": {
            "inner_actor_adaptation": "frozen",
            "inner_critic_adaptation": "frozen",
            "inner_temperature_mode": "inherit_outer"
          }
        }
      }
    },
    "temperature": {
      "description": "Change SAC entropy regularization independently of imagined behavior and execution noise.",
      "reference": "inherit_outer",
      "variants": {
        "inherit_outer": {
          "description": "Snapshot the outer alpha once per action.",
          "alg_params": {
            "inner_temperature_mode": "inherit_outer"
          }
        },
        "fixed_low": {
          "description": "Use a fixed local alpha of 0.1.",
          "alg_params": {
            "inner_temperature_mode": "fixed",
            "inner_temperature": 0.1
          }
        },
        "fixed_high": {
          "description": "Use a fixed local alpha of 1.0.",
          "alg_params": {
            "inner_temperature_mode": "fixed",
            "inner_temperature": 1.0
          }
        },
        "auto_local": {
          "description": "Adapt a root-local alpha in every joint SAC update slot.",
          "alg_params": {
            "inner_temperature_mode": "auto",
            "inner_temperature_initialization": "inherit_outer",
            "inner_target_entropy": "inherit_outer"
          }
        }
      }
    },
    "behavior_exploration": {
      "description": "Change imagined data collection without changing alpha or real execution behavior.",
      "reference": "policy_sample",
      "variants": {
        "policy_sample": {
          "description": "Sample the adapted stochastic policy at its learned standard deviation.",
          "alg_params": {
            "inner_behavior_action": "policy_sample",
            "inner_behavior_std_scale": 1.0,
            "inner_behavior_noise_std": 0.0
          }
        },
        "policy_sample_wide": {
          "description": "Sample the same policy with its standard deviation scaled by 1.5.",
          "alg_params": {
            "inner_behavior_action": "policy_sample",
            "inner_behavior_std_scale": 1.5,
            "inner_behavior_noise_std": 0.0
          }
        },
        "mean": {
          "description": "Collect deterministic policy-mean trajectories.",
          "alg_params": {
            "inner_behavior_action": "mean",
            "inner_behavior_std_scale": 1.0,
            "inner_behavior_noise_std": 0.0
          }
        },
        "mean_noise": {
          "description": "Collect policy means with independent Gaussian noise of standard deviation 0.1.",
          "alg_params": {
            "inner_behavior_action": "mean_plus_gaussian",
            "inner_behavior_std_scale": 1.0,
            "inner_behavior_noise_std": 0.1
          }
        }
      }
    },
    "execution_noise": {
      "description": "Change training-time returned-action sampling without changing imagined behavior or alpha. Frozen evaluation intentionally overrides all variants to the mean.",
      "frozen_evaluation": false,
      "frozen_evaluation_reason": "Frozen evaluation always returns the policy mean, so these training-time execution variants would be identical. Materialize and train this axis instead.",
      "reference": "policy_sample",
      "variants": {
        "policy_sample": {
          "description": "Sample the improved policy for real training actions.",
          "alg_params": {
            "inner_execution_action": "policy_sample",
            "inner_execution_std_scale": 1.0,
            "inner_execution_noise_std": 0.0
          }
        },
        "policy_sample_narrow": {
          "description": "Sample the improved policy with half its learned standard deviation.",
          "alg_params": {
            "inner_execution_action": "policy_sample",
            "inner_execution_std_scale": 0.5,
            "inner_execution_noise_std": 0.0
          }
        },
        "mean": {
          "description": "Return the improved policy mean.",
          "alg_params": {
            "inner_execution_action": "mean",
            "inner_execution_std_scale": 1.0,
            "inner_execution_noise_std": 0.0
          }
        },
        "mean_noise": {
          "description": "Return the improved policy mean plus Gaussian noise of standard deviation 0.1.",
          "alg_params": {
            "inner_execution_action": "mean_plus_gaussian",
            "inner_execution_std_scale": 1.0,
            "inner_execution_noise_std": 0.1
          }
        }
      }
    },
    "model_compute": {
      "description": "Vary imagined model steps by changing N while holding four total joint update slots and replay capacity fixed.",
      "reference": "steps_192",
      "variants": {
        "steps_96": {
          "description": "96 model steps: 8 rollouts per round at H=3 and four rounds.",
          "alg_params": {
            "inner_rollouts_per_round": 8,
            "inner_updates_per_round": 1,
            "inner_replay_capacity": 384
          }
        },
        "steps_192": {
          "description": "192 model steps: 16 rollouts per round at H=3 and four rounds.",
          "alg_params": {
            "inner_rollouts_per_round": 16,
            "inner_updates_per_round": 1,
            "inner_replay_capacity": 384
          }
        },
        "steps_384": {
          "description": "384 model steps: 32 rollouts per round at H=3 and four rounds.",
          "alg_params": {
            "inner_rollouts_per_round": 32,
            "inner_updates_per_round": 1,
            "inner_replay_capacity": 384
          }
        }
      }
    },
    "optimizer_compute": {
      "description": "Vary joint SAC update slots while holding imagined model steps fixed at 192 over two rounds.",
      "reference": "updates_4",
      "variants": {
        "updates_0": {
          "description": "Collect-only control with no gradient updates.",
          "alg_params": {
            "inner_rounds": 2,
            "inner_rollouts_per_round": 32,
            "inner_updates_per_round": 0,
            "inner_replay_capacity": 192
          }
        },
        "updates_2": {
          "description": "Two actor and two critic steps per action.",
          "alg_params": {
            "inner_rounds": 2,
            "inner_rollouts_per_round": 32,
            "inner_updates_per_round": 1,
            "inner_replay_capacity": 192
          }
        },
        "updates_4": {
          "description": "Four actor and four critic steps per action.",
          "alg_params": {
            "inner_rounds": 2,
            "inner_rollouts_per_round": 32,
            "inner_updates_per_round": 2,
            "inner_replay_capacity": 192
          }
        },
        "updates_8": {
          "description": "Eight actor and eight critic steps per action.",
          "alg_params": {
            "inner_rounds": 2,
            "inner_rollouts_per_round": 32,
            "inner_updates_per_round": 4,
            "inner_replay_capacity": 192
          }
        }
      }
    },
    "lifecycle": {
      "description": "Change all inner component, optimizer, and replay lifetimes together while rebasing persistent parameters onto current outer weights.",
      "reference": "action",
      "variants": {
        "action": {
          "description": "Discard all inner state after every real action.",
          "alg_params": {
            "inner_actor_scope": "action",
            "inner_critic_scope": "action",
            "inner_temperature_scope": "action",
            "inner_replay_scope": "action",
            "inner_actor_optimizer_scope": "action",
            "inner_critic_optimizer_scope": "action",
            "inner_temperature_optimizer_scope": "action",
            "inner_mppi_warm_start_scope": "action"
          }
        },
        "episode": {
          "description": "Retain inner state until the next episode boundary.",
          "alg_params": {
            "inner_actor_scope": "episode",
            "inner_critic_scope": "episode",
            "inner_temperature_scope": "episode",
            "inner_replay_scope": "episode",
            "inner_actor_optimizer_scope": "episode",
            "inner_critic_optimizer_scope": "episode",
            "inner_temperature_optimizer_scope": "episode",
            "inner_mppi_warm_start_scope": "episode",
            "inner_rebase_persistent": true
          }
        },
        "run": {
          "description": "Retain inner state for the full run and rebase after each outer update.",
          "alg_params": {
            "inner_actor_scope": "run",
            "inner_critic_scope": "run",
            "inner_temperature_scope": "run",
            "inner_replay_scope": "run",
            "inner_actor_optimizer_scope": "run",
            "inner_critic_optimizer_scope": "run",
            "inner_temperature_optimizer_scope": "run",
            "inner_mppi_warm_start_scope": "run",
            "inner_rebase_persistent": true
          }
        }
      }
    },
    "replay_sampling": {
      "description": "Compare replay replacement at a common batch size that is valid after the first collection round.",
      "reference": "with_replacement",
      "variants": {
        "with_replacement": {
          "description": "Sample 96 transitions with replacement.",
          "alg_params": {
            "inner_batch_size": 96,
            "inner_replay_sampling": "with_replacement"
          }
        },
        "without_replacement": {
          "description": "Sample 96 unique transitions within each update batch.",
          "alg_params": {
            "inner_batch_size": 96,
            "inner_replay_sampling": "without_replacement"
          }
        }
      }
    },
    "bootstrap_source": {
      "description": "Change the critic used only for inner TD bootstrapping.",
      "reference": "inner_target",
      "variants": {
        "inner_target": {
          "description": "Bootstrap from the locally adapted target critic.",
          "alg_params": {
            "inner_bootstrap_source": "inner_target"
          }
        },
        "outer_target": {
          "description": "Bootstrap from the frozen outer target critic.",
          "alg_params": {
            "inner_bootstrap_source": "outer_target"
          }
        },
        "outer_online": {
          "description": "Bootstrap from the frozen outer online critic.",
          "alg_params": {
            "inner_bootstrap_source": "outer_online"
          }
        }
      }
    },
    "control_horizon": {
      "description": "Vary inner control horizon while changing N inversely to hold the total at 180 model steps. H=5 intentionally exceeds the H=3 model-training horizon and emits a model-bias warning.",
      "reference": "horizon_3",
      "variants": {
        "horizon_1": {
          "description": "One-step imagined rollouts.",
          "alg_params": {
            "inner_rollouts_per_round": 45,
            "inner_rollout_horizon": 1,
            "inner_replay_capacity": 180
          }
        },
        "horizon_3": {
          "description": "Three-step imagined rollouts matching outer model training.",
          "alg_params": {
            "inner_rollouts_per_round": 15,
            "inner_rollout_horizon": 3,
            "inner_replay_capacity": 180
          }
        },
        "horizon_5": {
          "description": "Five-step imagined rollouts for explicit model-bias measurement.",
          "alg_params": {
            "inner_rollouts_per_round": 9,
            "inner_rollout_horizon": 5,
            "inner_replay_capacity": 180
          }
        }
      }
    },
    "adaptation_mechanism": {
      "description": "Compare full cloned modules with LoRA while keeping the adaptation algorithm and optimizer counts fixed.",
      "reference": "clone",
      "variants": {
        "clone": {
          "description": "Adapt full actor and critic copies.",
          "alg_params": {
            "inner_actor_adaptation": "clone",
            "inner_critic_adaptation": "clone"
          }
        },
        "lora": {
          "description": "Adapt rank-eight LoRA actor and critic deltas.",
          "alg_params": {
            "inner_actor_adaptation": "lora",
            "inner_critic_adaptation": "lora",
            "inner_actor_lora_rank": 8,
            "inner_critic_lora_rank": 8,
            "inner_actor_lora_scale": 1.0,
            "inner_critic_lora_scale": 1.0
          }
        }
      }
    },
    "lora_capacity": {
      "description": "Vary LoRA rank while holding its direct output scale fixed at one.",
      "reference": "rank_8",
      "variants": {
        "rank_4": {
          "description": "Rank-four actor and critic adapters at scale one.",
          "alg_params": {
            "inner_actor_adaptation": "lora",
            "inner_critic_adaptation": "lora",
            "inner_actor_lora_rank": 4,
            "inner_critic_lora_rank": 4,
            "inner_actor_lora_scale": 1.0,
            "inner_critic_lora_scale": 1.0
          }
        },
        "rank_8": {
          "description": "Rank-eight actor and critic adapters at scale one.",
          "alg_params": {
            "inner_actor_adaptation": "lora",
            "inner_critic_adaptation": "lora",
            "inner_actor_lora_rank": 8,
            "inner_critic_lora_rank": 8,
            "inner_actor_lora_scale": 1.0,
            "inner_critic_lora_scale": 1.0
          }
        },
        "rank_16": {
          "description": "Rank-sixteen actor and critic adapters at scale one.",
          "alg_params": {
            "inner_actor_adaptation": "lora",
            "inner_critic_adaptation": "lora",
            "inner_actor_lora_rank": 16,
            "inner_critic_lora_rank": 16,
            "inner_actor_lora_scale": 1.0,
            "inner_critic_lora_scale": 1.0
          }
        }
      }
    },
    "policy_anchor": {
      "description": "Vary SAC's KL anchor to the frozen outer policy independently of entropy.",
      "reference": "kl_0",
      "variants": {
        "kl_0": {
          "description": "No outer-policy KL penalty.",
          "alg_params": {
            "inner_outer_policy_kl_coef": 0.0
          }
        },
        "kl_001": {
          "description": "Outer-policy KL coefficient 0.01.",
          "alg_params": {
            "inner_outer_policy_kl_coef": 0.01
          }
        },
        "kl_01": {
          "description": "Outer-policy KL coefficient 0.1.",
          "alg_params": {
            "inner_outer_policy_kl_coef": 0.1
          }
        }
      }
    }
  }
}

