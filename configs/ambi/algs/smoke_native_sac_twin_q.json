{
  "seed": 55,
  "env": "Ant-v4",
  "alg": "SAC/SAC",
  "device": "cpu",
  "alg_params": {
    "verbose": 1,
    "buffer_size": 5000,
    "learning_starts": 16,
    "batch_size": 8,
    "gradient_steps": 1,
    "train_freq": 1,
    "learning_rate": 0.00005,
    "gamma": 0.99,
    "tau": 0.005,
    "ent_coef": "auto",
    "target_entropy": "auto",
    "target_update_interval": 1,
    "net_arch": [64, 64],
    "q_representation": "distributional",
    "num_q": 2,
    "q_pair_size": 2,
    "q_target_reduction": "min_pair",
    "q_actor_reduction": "min_pair",
    "q_num_bins": 101,
    "q_vmin": -10,
    "q_vmax": 10,
    "wandb": false
  },
  "total_steps": 20,
  "episodes": null
}
